# Environment Configuration
ENVIRONMENT=development  # development, staging, production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/personas
REDIS_URL=redis://localhost:6379/0

# AI Services
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Image Generation
# Midjourney (via third-party API)
MIDJOURNEY_API_KEY=xxx
# DALL-E uses OpenAI key above
# Stable Diffusion (if self-hosted)
SD_API_URL=http://localhost:7860

# Social Media
TWITTER_API_KEY=xxx
TWITTER_API_SECRET=xxx
TWITTER_ACCESS_TOKEN=xxx
TWITTER_ACCESS_SECRET=xxx
TWITTER_BEARER_TOKEN=xxx

INSTAGRAM_USERNAME=xxx
INSTAGRAM_PASSWORD=xxx

DISCORD_BOT_TOKEN=xxx

# Content Generation
RUNWAY_API_KEY=xxx
ELEVEN_LABS_API_KEY=xxx
SUNO_API_KEY=xxx

# Monitoring
SENTRY_DSN=xxx

# Agent Configuration
DEFAULT_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS_PER_REQUEST=4096
AGENT_TIMEZONE=America/New_York

# Safety & Limits
MAX_DAILY_COST_USD=50
ENABLE_CONTENT_MODERATION=true
REQUIRE_HUMAN_APPROVAL=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
